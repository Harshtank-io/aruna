# Canonical site URL for SEO metadata, sitemap, and Open Graph (no trailing slash).
# Defaults to https://aruna-light.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://aruna-light.vercel.app

# Google Gemini API key for live Aruna briefings.
# Get a free key at https://aistudio.google.com/apikey (no billing required).
# Supports a comma-separated pool of free keys — rotates to the next key on quota (429):
# GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=

# Optional model override (default: gemini-3.1-flash-lite).
# Free-tier friendly options: gemini-3.1-flash-lite | gemini-3.5-flash
# gemini-2.5-flash-lite is closed to new API keys — use 3.1+ instead.
GEMINI_MODEL=gemini-3.1-flash-lite
